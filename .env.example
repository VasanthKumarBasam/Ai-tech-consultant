# Copy to .env (./start.sh does this for you) and fill in your key.
ANTHROPIC_API_KEY=

# Demo without a key: deterministic stand-in model, clearly labelled "Demo model (fake)" in every UI.
# LLM_PROVIDER=fake

# ---- Task 1: Knowledge Brain (http://localhost:8001)
KB_EMBEDDER=fastembed                 # fastembed (local, free) | voyage (needs VOYAGE_API_KEY) | hash (offline test fallback)
# VOYAGE_API_KEY=
KB_ANSWER_MODEL=claude-sonnet-5-5
KB_VISION_MODEL=claude-haiku-5-5      # screenshot descriptions
KB_RETRIEVAL_MODE=hybrid              # vector | keyword | hybrid
KB_CRAWL_CONCURRENCY=2                # polite: 2 parallel requests ...
KB_CRAWL_DELAY_SECONDS=1.0            # ... and >= 1 s between requests to the help centre
KB_VISION_CONCURRENCY=6
KB_IMAGES_ENABLED=true
KB_SCHEDULER_ENABLED=true             # daily incremental update while the API is running
KB_DAILY_CRON="0 2 * * *"
KB_SCHEDULER_TZ=UTC                   # e.g. Asia/Kolkata to run at 02:00 your time
# KB_API_KEY=                         # optional shared secret; Tasks 2 and 3 send it as X-API-Key

# ---- Task 2: Inbox Agent (http://localhost:3002)
INBOX_CLASSIFY_MODEL=claude-haiku-5-5
INBOX_DRAFT_MODEL=claude-sonnet-5-5
AUTONOMY_THRESHOLD=20

# ---- Task 3: Meeting to Scope (http://localhost:8003)
SCOPE_MODEL_EXTRACT=claude-sonnet-5-5
SCOPE_MODEL_MERGE=claude-sonnet-5-5
SCOPE_MODEL_FEASIBILITY=claude-sonnet-5-5
SCOPE_MODEL_SCOPE=claude-sonnet-5-5
SCOPE_MODEL_ESTIMATE=claude-sonnet-5-5
SCOPE_MODEL_PROPOSAL=claude-sonnet-5-5
SCOPE_MODEL_REVIEW=claude-haiku-5-5
SCOPE_MODEL_CHANGE=claude-sonnet-5-5
SCOPE_HOURLY_RATE=95
SCOPE_CURRENCY=USD

# Shared
KB_URL=http://127.0.0.1:8001
COMPANY_NAME=Northstar Web Studio
# USD per million tokens, if the published prices differ from the defaults in code:
# MODEL_PRICING_JSON='{"claude-sonnet-5-5":[2,10],"claude-haiku-5-5":[0.1,0.5],"claude-opus-5-5":[4,20]}'
